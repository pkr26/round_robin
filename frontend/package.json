  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "jsdom": "^31.0.1",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
