  "findings": [
    {
      "id": "EVID-01",
      "priority": "P2",
      "title": "Preflight accepts selected files that cannot fit the evidence packet",
      "file": "backend/src/round_robin/api/preflight.py",
      "lines": [
        44,
        51
      ],
      "related_locations": [
        "backend/src/round_robin/api/artifacts.py:127",
        "backend/src/round_robin/orchestration/controller.py:89-93"
      ],
      "description": "The upload boundary permits one MiB, but preflight only checks ownership/readiness/hash/recipients. A selected 52,800-byte UTF-8 text file passes preflight without blockers or warnings, starts successfully, consumes an intake attempt and then deterministically fails the 24-passage runtime cap. The source shape and remaining packet capacity are known before Start. Live runs share this intake-first path, so this can waste a paid intake call for an input which cannot succeed.",
      "reproduction_script": "/tmp/round_robin_evidence_probe.py",
      "evidence": {
        "upload_bytes": 52800,
        "upload_status": 201,
        "upload_state": "ready",
        "preflight_status": 200,
        "preflight_blockers": [],
        "preflight_warnings": [],
        "start_status": 202,
        "terminal_status": "failed",
        "stop_reason": "context_limit_selected_passages",
        "attempt_stages": [
          "intake"
        ],
        "comparison": [],
        "provider_requests_external": 0
      },
      "suggested_fix": "Apply evidence packet and structured-source size validation during preflight and repeat it at Start; return an actionable blocker or provide explicit bounded excerpt selection before admission."
    },
    {
      "id": "EVID-02",
      "priority": "P2",
      "title": "Research reserve rejection leaves proposals permanently blocked on pending research",
      "file": "backend/src/round_robin/research/service.py",
      "lines": [
        116,
        120
      ],
      "related_locations": [
        "backend/src/round_robin/research/service.py:86-87",
        "backend/src/round_robin/research/service.py:56-61",
        "backend/src/round_robin/worker/research_tasks.py:7-14"
      ],
      "description": "Research hardcodes a 215-second reserve instead of using the frozen finish policy. A valid configuration with a 200-second active limit and 50-second finishing reserve therefore always throws before acquiring a lease. The transaction rolls back leaving research_state=pending. Reconciliation handles only running research, while schedule_research blocks proposals for pending research, so every redelivery fails and the run remains stuck until its active deadline. Default configurations encounter the same state when research starts late.",
      "reproduction_script": "/tmp/round_robin_research_probe.py",
      "evidence": {
        "provider_config_schema_valid": true,
        "active_limit": 200,
        "finish_reserved": 50,
        "errors": [
          "finish_time_reserve",
          "finish_time_reserve"
        ],
        "run_status": "running",
        "stage": "proposals",
        "research_state": "pending",
        "remaining_active_seconds": 199.942723,
        "reconciler_progressed": false,
        "proposal_steps": 0,
        "search_calls": 0,
        "external_provider_requests": 0
      },
      "suggested_fix": "Compute the allowance from the configured finish reserve and terminally settle unavailable research when no research time remains; enqueue advance so conditional text review can proceed."
    },
    {
      "id": "EVID-03",
      "priority": "P2",
      "title": "Every maintenance cycle re-purges the complete permanent deletion history",
      "file": "backend/src/round_robin/operations/maintenance.py",
      "lines": [
        56,
        57
      ],
      "related_locations": [
        "backend/src/round_robin/operations/recovery.py:123-128",
        "backend/src/round_robin/operations/recovery.py:93",
        "backend/src/round_robin/dispatcher/service.py:169-177"
      ],
      "description": "The minute-based dispatcher invokes maintenance synchronously. Maintenance reads the whole independently retained manifest and repeats purge_record for all historical entries without a batch bound or checking already-purged status. One already-purged meeting with one run executes 25 SQL statements on every pass and increments its fence again. As history grows, cleanup work grows with all past deletions and blocks the same loop responsible for dispatch and lease reconciliation; ordinary create/delete cycles are not constrained by the active meeting quota.",
      "reproduction_script": "/tmp/round_robin_maintenance_probe.py",
      "evidence": {
        "pass1": {
          "sql_statements": 25,
          "deletion_records_reapplied": 1,
          "run_execution_fence": 2
        },
        "pass2": {
          "sql_statements": 25,
          "deletion_records_reapplied": 1,
          "run_execution_fence": 3
        }
      },
      "suggested_fix": "Retain the full independent manifest for restore verification, but process active pending deletions in bounded batches and skip proven completed records during routine maintenance. Keep full replay as an explicit restore/purge operation."
    },
    {
      "id": "EVID-04",
      "priority": "P2",
      "title": "The expiry regression uses UTC yesterday against a Phoenix comparison date",
      "file": "backend/tests/test_evidence_regressions.py",
      "lines": [
        225,
        226
      ],
      "related_locations": [
        "backend/src/round_robin/orchestration/reporting.py:29-33"
      ],
      "description": "The regression creates expiry as utcnow().date()-1 while the sample brief uses America/Phoenix. Between midnight and 06:59 UTC that date is the current Phoenix date, so the quote is correctly considered current and the test incorrectly expects it to be expired. Root observed this failure in the full suite; the source inspection and current UTC/Phoenix calendars establish the cause. This is a test defect, not a stale-quote product defect.",
      "evidence": {
        "utc_observed": "2026-11-17 03:24 UTC",
        "phoenix_observed": "2026-11-16 20:24 MST",
        "expiry_constructed": "2026-11-16",
        "accepted_comparison_date": "2026-11-16",
        "actual_total": "1600.00",
        "incorrect_expected_total": null,
        "failure_window": "00:00 through 06:59 UTC each day"
      },
      "suggested_fix": "Freeze the clock and explicit comparison date in this test, or derive the expired quote date from the brief timezone."
    }
  ],
