{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 96,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "run.admitted",
        "content.committed",
        "report.published",
        "run.cancelled"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "record_id": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Id"
    },
    "description": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "timestamp",
    "event_type",
    "record_id",
    "description"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
