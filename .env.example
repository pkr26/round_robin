# Reference environment assignments. Local defaults work without loading this file.
ROUND_ROBIN_ENV=development
ROUND_ROBIN_EXECUTION_MODE=simulated
ROUND_ROBIN_PAID_ACCESS=0
ROUND_ROBIN_DATABASE_URL=postgresql+psycopg://round_robin:round_robin_local@127.0.0.1:55432/round_robin
ROUND_ROBIN_BROKER_URL=redis://127.0.0.1:56379/0
ROUND_ROBIN_ARTIFACT_DIRECTORY=.local/artifacts
# For hosted durability recovery, use private operator control storage on a
# separately provisioned volume; default: the artifact parent's durability-control.
# ROUND_ROBIN_DURABILITY_CONTROL_DIRECTORY=/absolute/private/control-volume/round-robin
NEXT_TELEMETRY_DISABLED=1

# Paid mode additionally requires an explicitly approved, unexpired configuration,
# configured prices/capabilities, operator policy unlock and a per-run Start.
# ROUND_ROBIN_PROVIDER_CONFIG_FILE=/absolute/private/provider-configuration.json
# OPENAI_API_KEY=server-side-secret
# ANTHROPIC_API_KEY=server-side-secret
# GEMINI_API_KEY=server-side-secret
# BRAVE_SEARCH_API_KEY=server-side-secret

# Optional hosted, visual and native profiles stay disabled by default.
# See docs/OPERATIONS.md before configuring them. Never expose keys as NEXT_PUBLIC_.

